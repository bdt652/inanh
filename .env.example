# MongoDB (external - update with your MongoDB connection)
MONGODB_URI=mongodb://username:password@your-mongodb-host:27017/inanh24h?authSource=inanh24h
DB_NAME=inanh24h
ADMIN_TOKEN_SECRET=change-this-secret
ADMIN_BOOTSTRAP_SECRET=change-this-bootstrap-secret
ADMIN_TOKEN_TTL_SECONDS=86400
CUSTOMER_TOKEN_SECRET=change-this-customer-secret
CUSTOMER_TOKEN_TTL_SECONDS=604800
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER_ID=InAnh24h
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_DEBUG=false
UPLOAD_MIN_FILES=1
UPLOAD_MAX_FILES=10000
UPLOAD_MAX_BYTES=20000000000
UPLOAD_REQUIRE_VERIFIED_PHONE_THRESHOLD=100
# ============================================
# STORAGE CONFIGURATION
# ============================================
# Storage backend: MUST be 'minio' - local storage is NOT supported in production
STORAGE_BACKEND=minio
# Upload mode: 'presigned' = browser uploads directly to MinIO (recommended), 'direct' = backend proxy uploads
NEXT_PUBLIC_UPLOAD_MODE=presigned
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
# Internal endpoint (backend container connects to MinIO via Docker network)
MINIO_ENDPOINT=http://minio:9000
# Public URL for direct file access (optional). If set, admin uploads return direct MinIO URLs.
# If empty/not set, all file access goes through backend proxy at /uploads/*
MINIO_PUBLIC_BASE_URL=https://media.inanh24h.com
MINIO_BUCKET_NAME=inanh24h-media
MINIO_SECURE=false
# CORS configuration for MinIO (required for presigned browser uploads)
MINIO_CORS_ALLOWEDORIGINS=https://inanh24h.com,https://www.inanh24h.com,https://api.inanh24h.com,http://localhost:3000
MINIO_CORS_ALLOWEDMETHODS=GET,PUT,POST,HEAD
MINIO_CORS_ALLOWEDHEADERS=*
MINIO_CORS_MAXAGESECONDS=3000
# Public MinIO URL for frontend (if set, frontend uses direct MinIO URLs instead of backend proxy)
NEXT_PUBLIC_MINIO_PUBLIC_BASE_URL=https://media.inanh24h.com
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://api:8000/api/v1
NEXT_PUBLIC_SITE_URL=https://inanh24h.com
CORS_ALLOW_ORIGINS=["http://localhost:3000","https://inanh24h.com","https://www.inanh24h.com"]
# ============================================
# ON-DEMAND REVALIDATION (Phase 8A)
# ============================================
# Secret used by the backend to trigger ISR revalidation on the frontend
# Must match REVALIDATE_SECRET in the Next.js container
REVALIDATE_SECRET=change-this-to-a-long-random-string
# Internal URL of the Next.js frontend (as seen from the backend container)
FRONTEND_INTERNAL_URL=http://web:3000
